# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Switched to dynamic framework linking to fix a persistent, non-deterministic
# 'FirebaseAuth/FirebaseAuth-Swift.h' file not found build error under static linking —
# see the removed post_install hacks below (kept in git history) for everything tried first.
# Dynamic frameworks embed each pod's Swift/ObjC interop headers inside the framework bundle
# itself, found automatically via framework search paths, which sidesteps this whole class of
# static-lib header-timing race rather than working around it.
use_frameworks! :linkage => :dynamic

target 'TambooPartner' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        end
      end
      # react-native-image-picker uses kUTTypeJPEG/kUTTypeMovie (MobileCoreServices constants)
      # without declaring that framework as a dependency in its podspec. Under static linking
      # this was masked by getting pulled in transitively from elsewhere; under use_frameworks!
      # dynamic linking each framework only sees what it explicitly links, so it needs adding
      # here directly — "ld: symbol(s) not found ... _kUTTypeJPEG/_kUTTypeMovie" otherwise.
      if target.name == 'react-native-image-picker'
        target.build_configurations.each do |config|
          flags = config.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
          flags = [flags] if flags.is_a?(String)
          # Mixes legacy (kUTTypeJPEG, MobileCoreServices) and modern (UTTypeImage,
          # UniformTypeIdentifiers) UTI APIs across different files — needs both frameworks.
          flags += ['-framework', 'MobileCoreServices', '-framework', 'UniformTypeIdentifiers']
          config.build_settings['OTHER_LDFLAGS'] = flags
        end
      end
    end
  end
end
