MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tamboo
JWT_SECRET=replace-with-a-long-random-string
PORT=4001

# Path to the downloaded Firebase Admin SDK service account JSON (see README),
# OR set FIREBASE_SERVICE_ACCOUNT_JSON with the file's full contents inline
# (used on Render, where a file isn't convenient to upload).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Razorpay test-mode keys (Dashboard → Settings → API Keys → Generate Test Key).
# Safe to rotate any time since these are test-mode only, no real money involved.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
