MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tamboo
JWT_SECRET=replace-with-a-long-random-string
PORT=4001

# Path to the downloaded Firebase Admin SDK service account JSON (see README),
# OR set FIREBASE_SERVICE_ACCOUNT_JSON with the file's full contents inline
# (used on Render, where a file isn't convenient to upload).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
